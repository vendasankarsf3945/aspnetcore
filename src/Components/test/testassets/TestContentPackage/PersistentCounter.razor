@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

<!-- The render changes when the component is resumed because it runs in a separate circuit -->
@if (RendererInfo.IsInteractive)
{
    <p>Interactive <span id="render-mode-interactive">@RendererInfo.IsInteractive</span></p>
}
<p>Current render GUID: <span id="persistent-counter-render">@Guid.NewGuid().ToString()</span></p>


<p>Current count: <span id="persistent-counter-count">@State.Count</span></p>
<p>Non-persisted counter: <span id="non-persisted-counter">@NonPersistedCounter</span></p>

<button id="increment-persistent-counter-count" @onclick="IncrementCount">Click me</button>
<button id="increment-non-persisted-counter" @onclick="IncrementNonPersistedCount">Increment non-persisted</button>

@code {

    [PersistentState]
    public CounterState State { get; set; }

    [PersistentState(RestoreBehavior = RestoreBehavior.SkipLastSnapshot)]
    public int NonPersistedCounter { get; set; }

    public class CounterState
    {
        public int Count { get; set; } = 0;
    }

    protected override void OnInitialized()
    {
        // State is preserved across disconnections
        State ??= new CounterState();

        // Initialize non-persisted counter to 5 during SSR (before interactivity)
        if (!RendererInfo.IsInteractive)
        {
            NonPersistedCounter = 5;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && RendererInfo.IsInteractive)
        {
            // Register to track circuit invocation failures for testing
            await JSRuntime.InvokeVoidAsync("setupCircuitFailureTracking");
        }
    }

    private void IncrementCount()
    {
        State.Count = State.Count + 1;
    }

    private void IncrementNonPersistedCount()
    {
        NonPersistedCounter = NonPersistedCounter + 1;
    }
}

<script>
    window.setupCircuitFailureTracking = function() {
        // Track which circuit hub method failed during reconnection/resumption
        // The CircuitManager catches errors from ConnectCircuit and ResumeCircuit invocations
        // We hook into the circuit handlers to detect these failures
        if (window.Blazor && window.Blazor._internal && window.Blazor._internal.circuitManager) {
            var circuitManager = window.Blazor._internal.circuitManager;
            
            // Store the original reconnect method
            var originalReconnect = circuitManager.reconnect;
            circuitManager.reconnect = async function() {
                try {
                    return await originalReconnect.call(this);
                } catch (error) {
                    // The server injected an error message like "Test-injected failure for ConnectCircuit invocation"
                    if (error && error.message) {
                        var match = error.message.match(/(ConnectCircuit|ResumeCircuit)/);
                        if (match) {
                            window.failedCircuitInvocation = match[1];
                        }
                    }
                    throw error;
                }
            };
            
            // Also hook into resume for the ResumeCircuit failure case
            var originalResume = circuitManager.resume;
            if (originalResume) {
                circuitManager.resume = async function() {
                    try {
                        return await originalResume.call(this);
                    } catch (error) {
                        // Extract the failed method name from the error message
                        if (error && error.message) {
                            var match = error.message.match(/(ConnectCircuit|ResumeCircuit)/);
                            if (match) {
                                window.failedCircuitInvocation = match[1];
                            }
                        }
                        throw error;
                    }
                };
            }
        }
    };
</script>
